<Window x:Class="PE01.Expresso.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PE01.Expresso.Wpf"
        mc:Ignorable="d"
        Title="Express-o" Height="364.8" Width="818" Loaded="Window_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="64*"/>
            <ColumnDefinition Width="749*"/>
        </Grid.ColumnDefinitions>
        <ComboBox x:Name="cmbSize" HorizontalAlignment="Left" Margin="14,31,0,0" VerticalAlignment="Top" Width="200" Grid.Column="2"/>
        <Label Content="Grootte:" HorizontalAlignment="Center" Margin="0,28,0,0" VerticalAlignment="Top" Grid.Column="1"/>
        <ListBox x:Name="lstCoffees" HorizontalAlignment="Left" Height="100" Margin="14,58,0,0" VerticalAlignment="Top" Width="200" Grid.Column="2"/>
        <Label Content="Koffiesoort:" HorizontalAlignment="Left" Margin="5,59,0,0" VerticalAlignment="Top" Grid.ColumnSpan="2" Grid.Column="1"/>
        <TextBox x:Name="txtNewCoffee" HorizontalAlignment="Left" Height="23" Margin="535,34,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="114" Grid.Column="2"/>
        <Label Content="Nieuw:" HorizontalAlignment="Left" Margin="483,31,0,0" VerticalAlignment="Top" Grid.Column="2"/>
        <Button x:Name="btnAdd" Content="Toevoegen" HorizontalAlignment="Left" Margin="654,34,0,0" VerticalAlignment="Top" Width="75" Height="23" Grid.Column="2"/>
        <TextBox x:Name="txtCups" HorizontalAlignment="Left" Height="23" Margin="14,191,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="200" Grid.Column="2"/>
        <Label Content="Kopjes:" HorizontalAlignment="Left" Margin="5,191,0,0" VerticalAlignment="Top" Grid.Column="1"/>
        <TextBox x:Name="txtTip" HorizontalAlignment="Left" Height="23" Margin="14,219,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="200" Grid.Column="2"/>
        <Label Content="Fooi:" HorizontalAlignment="Left" Margin="5,219,0,0" VerticalAlignment="Top" Grid.Column="1"/>
        <Button x:Name="btnOrder" Content="Bestel" HorizontalAlignment="Left" Margin="14,247,0,0" VerticalAlignment="Top" Width="200"  Grid.Column="2" Click="BtnOrder_Click"/>
        <ListBox x:Name="lstOrders" HorizontalAlignment="Left" Height="259" Margin="219,31,0,0" VerticalAlignment="Top" Width="259" Background="#FFEEEEEE" Grid.Column="2"/>
        <Button x:Name="btnQueue" Content="Plaats in wachtrij" Grid.Column="2" HorizontalAlignment="Left" Margin="14,271,0,0" VerticalAlignment="Top" Width="200" Click="BtnQueue_Click"/>
        <StackPanel x:Name="stpQueue" Orientation="Horizontal" Grid.Column="2" Margin="483,67,14,231">
            <Label Content="Wachtrij:" VerticalAlignment="Top" Height="25"/>
            <Button x:Name="btnEmptyQueue" Content="Wachtrij afhandelen" VerticalAlignment="Top" Margin="0,0,0,0" Height="25" Width="190" />
        </StackPanel>
        <Label Content="Aantal klanten:" Grid.Column="2" HorizontalAlignment="Left" Margin="483,219,0,0" VerticalAlignment="Top" Height="26" Width="101"/>
        <Label Content="Koffies verkocht:" Grid.Column="2" HorizontalAlignment="Left" Margin="483,244,0,0" VerticalAlignment="Top" Width="101"/>
        <Label Content="Inkomsten:" Grid.Column="2" HorizontalAlignment="Left" Margin="483,264,0,0" VerticalAlignment="Top" Width="101"/>
        <Label x:Name="lblNumberOfCustomers" Content="" Grid.Column="2" HorizontalAlignment="Left" Margin="584,219,0,0" VerticalAlignment="Top" Width="145"/>
        <Label x:Name="lblCoffeesSold" Content="" Grid.Column="2" HorizontalAlignment="Left" Margin="584,244,0,0" VerticalAlignment="Top" Width="145"/>
        <Label x:Name="lblProfit" Content="" Grid.Column="2" HorizontalAlignment="Left" Margin="584,264,0,0" VerticalAlignment="Top" Width="145"/>
    </Grid>
</Window>
